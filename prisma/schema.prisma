enum EstadoComite {
  ACTIVO
  PENDIENTE_INTEGRACION
  REQUIERE_ACTUALIZACION
  INACTIVO
}

/// Registro del Comité de Convivencia y Seguridad de una escuela
model ComiteEscolarRegistro {
