generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ─────────────────────────────────────

enum EstadoEntrega {
  PENDIENTE
  EN_REVISION
  REQUIERE_CORRECCION
  APROBADO
  NO_APROBADO
  NO_ENTREGADO
  EXENTO
  ENTREGADO_FISICO
}

enum TipoPeriodo {
  ANUAL
  SEMESTRAL
  MENSUAL
}

// ─── Models ────────────────────────────────────

model Admin {
  id             String       @id @default(cuid())
  email          String       @unique
  password       String
  nombre         String
  role           String       @default("ATP_LECTOR")
  organizacionId String       @default("zona004")
  permisos       Json?
  correcciones   Correccion[]
}

model Escuela {
  id        String   @id @default(cuid())
  cct       String   @unique
  nombre    String
  localidad String
  municipio    String?
  zonaEscolar  String?
  codigoPostal String?
  email     String   @unique
  password  String
  director  String?
  hombres   Int      @default(0)
  mujeres   Int      @default(0)
  total     Int      @default(0)
  rol       String   @default("director")
  ultimoIngreso DateTime?
  geminiApiKey  String?
  esDePrueba    Boolean  @default(false)
  esSupervision Boolean  @default(false)
  permisos      Json?
  gruposPrimerAno  Int  @default(1) // 1er Año (Semestres 1º y 2º)
  gruposSegundoAno Int  @default(1) // 2º Año (Semestres 3º y 4º)
  gruposTercerAno  Int  @default(1) // 3er Año (Semestres 5º y 6º)
  mapaCurricularCompletado Boolean @default(false)
  tipoBachillerato String @default("BACHILLERATO_GENERAL") // "BACHILLERATO_GENERAL" | "BACHILLERATO_TECNOLOGICO"
  trayectoTecnologico String? // "FISICO_MATEMATICAS" | "ECONOMICO_ADMINISTRATIVA" | "QUIMICO_BIOLOGICA" | "HUMANIDADES_Y_CIENCIAS_SOCIALES"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entregas Entrega[]
  configuraciones ConfiguracionPrograma[]
  inscripcionesEventos InscripcionEvento[]
  inscripcionesOlimpiadas InscripcionOlimpiada[]
  inscripcionesPAEC InscripcionEncuentroPAEC[]
  descargasCircular05 Circular05Descarga[]
  capemRegistros CapemFichaRegistro[]
  personal Personal[]
  directorExpediente DirectorExpediente?
  documentosAdmin DocumentoAdministrativo[]
  
  // ─── Generador de Horarios con IA ───
  horarioConfiguracion HorarioConfiguracion?
  horariosGenerados HorarioGenerado[]
  horarioGrupos HorarioGrupo[]
  horarioAulas HorarioAula[]
  horarioAsignaturasHorario HorarioAsignaturaCatalogo[]
  horarioCargas HorarioCargaDocente[]
  horarioStats  HorarioStats?

  // ─── Revisión de Planeaciones con IA ───
  planeaciones PlaneacionDidactica[]

  // ─── Auditoría Estadística 911 / SICEP ───
  estadistica911Registros Estadistica911Registro[]

  // ─── Acompañamiento CTE ───
  cteProductos CteProductoEscuela[]

  // ─── Comités de Convivencia y Seguridad ───
  comiteRegistros ComiteEscolarRegistro[]

  // ─── Vigilancia Proactiva y Centro de Alertas ───
  alertasProactivas AlertaProactiva[]

  // ─── Cédulas Móviles de Supervisión ───
  cedulasSupervision CedulaSupervision[]

  // ─── OCR de Boletas y Documentos Históricos ───
  ocrBoletas OcrBoleta[]
}


model CicloEscolar {
  id     String   @id @default(cuid())
  nombre String   @unique // "2025-2026"
  inicio DateTime // 2025-08-01
  fin    DateTime // 2026-07-31
  activo Boolean  @default(true)
  anuncioGlobal String?
  evaluarSoloActivosRanking Boolean @default(false)

  periodos PeriodoEntrega[]
  capems   Capem[]
  inscripcionesEventos     InscripcionEvento[]
  inscripcionesOlimpiadas  InscripcionOlimpiada[]
  inscripcionesPAEC        InscripcionEncuentroPAEC[]
  descargasCircular05      Circular05Descarga[]
  horariosGenerados        HorarioGenerado[]
  estadistica911Registros  Estadistica911Registro[]
}

model Programa {
  id               String           @id @default(cuid())
  nombre           String           @unique
  descripcion      String?
  tipo             TipoPeriodo      @default(ANUAL)
  numArchivos      Int              @default(1) // Día Naranja = 2
  orden            Int              @default(0)
  etiquetasArchivos String[]       @default([])
  recordatorioAuto Boolean          @default(false)
  esParaSupervision Boolean         @default(false)
  activo           Boolean          @default(true)
  visibleEnDirector Boolean         @default(true)
  quienesPuedenSubir String[]       @default(["director"])
  createdAt        DateTime         @default(now())

  periodos PeriodoEntrega[]
  recursos Recurso[]
  configuraciones ConfiguracionPrograma[]
}

model PeriodoEntrega {
  id             String   @id @default(cuid())
  cicloEscolarId String
  programaId     String
  mes            Int?     // 1-12 para MENSUAL
  semestre       Int?     // 1 o 2 para SEMESTRAL
  activo         Boolean  @default(true)
  fechaLimite    DateTime?
  createdAt      DateTime @default(now())

  cicloEscolar CicloEscolar @relation(fields: [cicloEscolarId], references: [id])
  programa     Programa     @relation(fields: [programaId], references: [id])
  entregas     Entrega[]

  @@unique([cicloEscolarId, programaId, mes, semestre])
}

model Entrega {
  id               String         @id @default(cuid())
  escuelaId        String
  periodoEntregaId String
  estado           EstadoEntrega  @default(NO_ENTREGADO)
  observacionesATP String?
  fechaSubida      DateTime?
  fechaRevision    DateTime?
  firmaDigital     String?
  cvd              String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  escuela        Escuela        @relation(fields: [escuelaId], references: [id], onDelete: Cascade)
  periodoEntrega PeriodoEntrega @relation(fields: [periodoEntregaId], references: [id])
  archivos       Archivo[]
  correcciones   Correccion[]
  preRevision    PreRevision?
  chatMensajes   ChatMensaje[]

  @@unique([escuelaId, periodoEntregaId])
}

model Archivo {
  id        String   @id @default(cuid())
  entregaId String
  nombre    String
  driveId   String?
  driveUrl  String?
  tipo      String   @default("ENTREGA") // ENTREGA | CORRECCION
  subidoPor String   @default("director") // director | atp
  etiqueta  String?  // "Registro", "Evidencias" (Día Naranja)
  createdAt DateTime @default(now())

  entrega    Entrega     @relation(fields: [entregaId], references: [id], onDelete: Cascade)
  correccion Correccion?
}

model Correccion {
  id         String   @id @default(cuid())
  entregaId  String
  texto      String?
  archivoId  String?  @unique
  adminId    String
  createdAt  DateTime @default(now())

  entrega  Entrega  @relation(fields: [entregaId], references: [id], onDelete: Cascade)
  archivo  Archivo? @relation(fields: [archivoId], references: [id])
  admin    Admin    @relation(fields: [adminId], references: [id])
}

model Recurso {
  id            String   @id @default(cuid())
  titulo        String
  descripcion   String?
  archivoNombre String
  archivoDriveId  String?
  archivoDriveUrl String?
  programaId    String?
  createdAt     DateTime @default(now())

  programa Programa? @relation(fields: [programaId], references: [id])
}

model ConfiguracionPrograma {
  id          String   @id @default(cuid())
  escuelaId   String
  programaId  String
  numArchivos Int      @default(1)
  createdAt   DateTime @default(now())

  escuela     Escuela  @relation(fields: [escuelaId], references: [id], onDelete: Cascade)
  programa    Programa @relation(fields: [programaId], references: [id], onDelete: Cascade)

  @@unique([escuelaId, programaId])
}

// ─── Eventos Culturales 2026 ─────────────────────

model CategoriaEvento {
  id          String   @id @default(cuid())
  nombre      String   @unique
  color       String   @default("#2e75b6")
  orden       Int      @default(0)
  createdAt   DateTime @default(now())

  disciplinas DisciplinaEvento[]
}

model DisciplinaEvento {
  id               String   @id @default(cuid())
  categoriaId      String
  nombre           String
  tipo             String   // "simple" | "individual" | "equipo" | "grupo"
  minParticipantes Int      @default(1)
  maxParticipantes Int      @default(1)
  grupoExclusion   String?  // ID de grupo para exclusión mutua (ej. "canto")
  orden            Int      @default(0)
  createdAt        DateTime @default(now())

  categoria        CategoriaEvento @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
}

model EventosConfig {
  id          String    @id @default("singleton")
  activo      Boolean   @default(false)
  fechaLimite DateTime?
}

model InscripcionEvento {
  id             String   @id @default(cuid())
  escuelaId      String
  cicloEscolarId String
  datos          Json     // { [disciplinaId]: { participa: boolean, numParticipantes: number } }
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  escuela      Escuela      @relation(fields: [escuelaId], references: [id], onDelete: Cascade)
  cicloEscolar CicloEscolar @relation(fields: [cicloEscolarId], references: [id], onDelete: Cascade)

  @@unique([escuelaId, cicloEscolarId])
  @@map("InscripcionEvento2026")
}

// ─── Proyecto Circular 05 ────────────────────────

model Circular05Config {
  id                String  @id @default("singleton")
  activo            Boolean @default(false)
  destinatario      String  @default("ING. ALEJANDRO ESCAMILLA MARTINEZ")
  cargoDestinatario String  @default("SUPERVISOR ESCOLAR DE BACHILLERATOS GENERALES")
  zonaDestinatario  String  @default("ZONA 004, VENUSTIANO CARRANZA PUEBLA")
}

model Circular05Descarga {
  id             String   @id @default(cuid())
  escuelaId      String
  cicloEscolarId String
  datos          Json
  createdAt      DateTime @default(now())

  escuela      Escuela      @relation(fields: [escuelaId], references: [id], onDelete: Cascade)
  cicloEscolar CicloEscolar @relation(fields: [cicloEscolarId], references: [id], onDelete: Cascade)
}

model Circular05Disciplina {
  id     String  @id @default(cuid())
  nombre String  @unique
  area   String  @default("")
  activo Boolean @default(true)
  orden  Int     @default(0)
}

// ─── Olimpiada de Matemáticas 2026 ───────────────

model OlimpiadaConfig {
  id              String    @id @default("singleton")
  activo          Boolean   @default(false)
  convocatoriaUrl String?
  fechaLimite     DateTime?
}

model InscripcionOlimpiada {
  id             String   @id @default(cuid())
  escuelaId      String
  cicloEscolarId String
  datos          Json     // { alumnos: [{nombre, grado, curp}] }
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  escuela      Escuela      @relation(fields: [escuelaId], references: [id], onDelete: Cascade)
  cicloEscolar CicloEscolar @relation(fields: [cicloEscolarId], references: [id], onDelete: Cascade)

  @@unique([escuelaId, cicloEscolarId])
}

// ─── Encuentro PAEC 2026 ────────────────────────

model EncuentroPAECConfig {
  id               String    @id @default("singleton")
  activo           Boolean   @default(false)
  convocatoriaUrl  String?
  encuentroUrl     String?
  fechaLimite      DateTime?
}

model InscripcionEncuentroPAEC {
  id             String   @id @default(cuid())
  escuelaId      String
  cicloEscolarId String
  datos          Json     // { nombreProyecto, problematicaEntorno, alumnos: [{nombre, grado, curp}] }
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  escuela      Escuela      @relation(fields: [escuelaId], references: [id], onDelete: Cascade)
  cicloEscolar CicloEscolar @relation(fields: [cicloEscolarId], references: [id], onDelete: Cascade)

  @@unique([escuelaId, cicloEscolarId])
}

// ─── Configuración de Visibilidad del Sidebar Admin ──

model AdminSidebarConfig {
  id              String  @id @default("singleton")
  showRecursos    Boolean @default(true)
  showEventos     Boolean @default(true)
  showCircular05  Boolean @default(true)
  showOlimpiada   Boolean @default(true)
  showPAEC        Boolean @default(true)
  showCapems      Boolean @default(true)
  showExpedientes Boolean @default(true)
  showOficios     Boolean @default(true)
  showSparh       Boolean @default(true)
  showBecas          Boolean @default(true)
  showEstadistica911 Boolean @default(true)
  showCte            Boolean @default(true)
  showUsicamm        Boolean @default(true)
  showComites        Boolean @default(true)
}

// ─── Autoridades Educativas (Constancias) ────────

model AutoridadesConfig {
  id                  String @id @default("singleton")
  tenantId            String @default("zona004")
  nombreSupervision   String @default("SUPERVISIÓN ESCOLAR DE BACHILLERATOS GENERALES ZONA 004")
  zona                String @default("004")
  cct                 String @default("21FMS0020X")
  municipio           String @default("Venustiano Carranza")
  entidad             String @default("Puebla")
  numeroOficioBase    String @default("SEP-A/ZONA004/")
  emailReporteNivel   String @default("dbepa.igualdad@seppue.gob.mx")

  supervisor          String @default("C. SUPERVISOR(A)")
  supervisorRFC       String @default("")
  supervisorFecha     String @default("")
  supervisorClave     String @default("")

  coordinadorRegional String @default("C. COORDINADOR(A) REGIONAL")
  directorNivel       String @default("C. DIRECTOR(A) DEL NIVEL")

  atp1Nombre          String @default("")
  atp1RFC             String @default("")
  atp1Fecha           String @default("")
  atp1Clave           String @default("")

  atp2Nombre          String @default("")
  atp2RFC             String @default("")
  atp2Fecha           String @default("")
  atp2Clave           String @default("")

  atp3Nombre          String @default("")
  atp3RFC             String @default("")
  atp3Fecha           String @default("")
  atp3Clave           String @default("")

  atp4Nombre          String @default("")
  atp4RFC             String @default("")
  atp4Fecha           String @default("")
  atp4Clave           String @default("")
}

// ─── CAPEMS ─────────────────────────────────────────

model Ficha {
  id        String   @id @default(cuid())
  nombre    String   @unique
  activo    Boolean  @default(true)
  orden     Int      @default(0)
  createdAt DateTime @default(now())

  registros CapemFichaRegistro[]
}

model Capem {
  id             String   @id @default(cuid())
  nombre         String
  orden          Int      @default(0)
  activo         Boolean  @default(true)
  cicloEscolarId String
  createdAt      DateTime @default(now())

  cicloEscolar CicloEscolar        @relation(fields: [cicloEscolarId], references: [id])
  registros    CapemFichaRegistro[]

  @@unique([cicloEscolarId, nombre])
}

model CapemsConfig {
  id          String    @id @default("singleton")
  activo      Boolean   @default(false)
  fechaLimite DateTime?
}

model CapemFichaRegistro {
  id              String   @id @default(cuid())
  escuelaId       String
  capemId         String
  fichaId         String
  archivoNombre   String?
  archivoDriveId  String?
  archivoDriveUrl String?
  bloqueado       Boolean  @default(false)
  validoIA        String?  // "APROBADO" | "ADVERTENCIA" | "RECHAZADO" | "PENDIENTE"
  observacionesIA String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  escuela Escuela @relation(fields: [escuelaId], references: [id], onDelete: Cascade)
  capem   Capem   @relation(fields: [capemId], references: [id], onDelete: Cascade)
  ficha   Ficha   @relation(fields: [fichaId], references: [id])
}

// ─── Expedientes de Personal ──────────────────────────

model ExpedientesConfig {
  id     String  @id @default("singleton")
  activo Boolean @default(false)
}

model Personal {
  id               String   @id @default(cuid())
  escuelaId        String
  nombre           String   // Nombre(s)
  apellidoPaterno  String
  apellidoMaterno  String
  sexo             String   // "MASCULINO" | "FEMENINO"
  cargo            String   // "RESPONSABLE" | "DOCENTE" | "ADMINISTRATIVO" | "APOYO"
  curp             String?
  rfc              String?
  telefono         String?
  correoElectronico String?
  gradoAcademico   String?  // "LICENCIATURA" | "MAESTRIA" | "DOCTORADO" | "OTRO"
  fechaIngreso     DateTime?
  clavePresupuestal String?
  horasOficiales   Int      @default(20)
  orden            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  escuela    Escuela             @relation(fields: [escuelaId], references: [id], onDelete: Cascade)
  documentos DocumentoPersonal[]
  documentosAdmin DocumentoAdministrativo[]
  horarioCargas   HorarioCargaDocente[]
  horarioCeldas   HorarioCelda[]
}

model DocumentoPersonal {
  id               String   @id @default(cuid())
  personalId       String
  tipoDocumento    String   // "TITULO", "CEDULA", "ACTA_NACIMIENTO", "CURP", etc. o "CUSTOM"
  etiqueta         String?  // Nombre personalizado para documentos extra
  archivoNombre    String?
  archivoDriveId   String?
  archivoDriveUrl  String?
  bloqueado        Boolean  @default(false)
  validoIA         String?  // "APROBADO" | "ADVERTENCIA" | "RECHAZADO" | "PENDIENTE"
  observacionesIA  String?
  noTiene          Boolean  @default(false)
  orden            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  personal         Personal @relation(fields: [personalId], references: [id], onDelete: Cascade)
}

model PreRevision {
  id             String   @id @default(cuid())
  entregaId      String   @unique
  resultado      Json     // Contiene { cumpleFirmas: boolean, borradorCorreo: string, etc. }
  intentosUsados Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  entrega   Entrega  @relation(fields: [entregaId], references: [id], onDelete: Cascade)
}

model PreRevisionConfig {
  id              String  @id @default("singleton")
  activoDirectores Boolean @default(false)
  mantenimiento   Boolean @default(false)
  limiteIntentos  Int     @default(3)
  providerDefault String  @default("gemini")
  modelDefault    String  @default("gemini-3.5-flash-lite")  // Modelo autorizado principal
  providerPremium String  @default("gemini")
  modelPremium    String  @default("gemini-3.1-flash-lite")  // Fallback autorizado
  modoSinRestriccionesHorarios    Boolean @default(false)  // Si true, saltea todos los requisitos del módulo Horarios IA
  requiereApiKeyHorarios         Boolean @default(true)   // Si true, la escuela debe tener API Key para usar Horarios IA
  requiereExpedientesHorarios    Boolean @default(true)   // Si true, la escuela debe haber subido expedientes de personal
  activoGlobalHorarios           Boolean @default(true)   // Interruptor global: si false, ninguna escuela puede usar Horarios IA
}

model PlantillaEvaluacion {
  id        String   @id @default(cuid())
  modulo    String   // "PMC" | "PAEC"
  nombre    String   // ej. "Rúbrica de Diagnóstico Colectivo 2025"
  contenido String   // El prompt maestro, lineamientos o rúbrica completa
  activo    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model ApiKey {
  id          String   @id @default(cuid())
  provider    String   // "gemini" | "openai" | "claude" | "openrouter" | "deepseek"
  key         String
  label       String
  active      Boolean  @default(true)
  errorCount  Int      @default(0)
  isPremium   Boolean  @default(false)
  usageCount  Int      @default(0)
  lastUsedAt  DateTime?
  lastModel   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChatMensaje {
  id        String   @id @default(cuid())
  entregaId String
  role      String   // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())

  entrega   Entrega  @relation(fields: [entregaId], references: [id], onDelete: Cascade)
}

// ─── Documentos Administrativos ──────────────────

model DirectorExpediente {
  id                 String    @id @default(cuid())
  nombreCompleto     String
  rfc                String?
  curp               String?
  fechaIngreso       DateTime?
  clavePresupuestal  String?
  telefono           String?
  correo             String?
  
  // Relación con su escuela actual (una o ninguna si está en transición)
  escuelaActualId    String?   @unique
  escuelaActual      Escuela?  @relation(fields: [escuelaActualId], references: [id])
  
  // Historial y Documentos
  documentosGenerados DocumentoAdministrativo[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model PlantillaDocumento {
  id                  String   @id @default(cuid())
  nombre              String   // Ej. "Constancia de No Adeudo 2025"
  archivoNombre       String   // Nombre del docx original
  archivoDriveId      String   // Cloudinary public_id
  archivoDriveUrl     String   // Cloudinary URL
  hash                String   // Para detectar subidas del mismo archivo
  estado              String   @default("NUEVA") // NUEVA | CONFIGURADA
  configuracionCampos Json?    // Mapeo detectado por IA y aprobado por Admin
  tiposDestinatario   String[] @default([]) // ["DIRECTOR","ATP","PERSONAL"]

  documentosGenerados DocumentoAdministrativo[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model DocumentoAdministrativo {
  id                 String   @id @default(cuid())
  tipo               String   // Ej. "CONSTANCIA_NO_ADEUDO"
  plantillaId        String
  directorId         String?
  personalId         String?
  escuelaId          String?
  generadoPorId      String   // ID de Admin o Director que lo generó
  datosUtilizados    Json     // Los datos congelados al momento de generar
  archivoWordId      String?  // Cloudinary ID del doc generado
  archivoWordUrl     String?
  archivoPdfId       String?  // Cloudinary ID del PDF generado
  archivoPdfUrl      String?
  createdAt          DateTime @default(now())

  plantilla          PlantillaDocumento @relation(fields: [plantillaId], references: [id])
  director           DirectorExpediente? @relation(fields: [directorId], references: [id])
  personal           Personal? @relation(fields: [personalId], references: [id])
  escuela            Escuela? @relation(fields: [escuelaId], references: [id])
}

// ─── Generador de Horarios con IA ──────────────────

model HorarioAsignaturaCatalogo {
  id              String   @id @default(cuid())
  escuelaId       String?  // NULL = Catálogo oficial MCCEMS 203 UACs. Si tiene ID = Materia personalizada
  uacName         String
  semester        Int      // 1 al 6
  component       String   // "fundamental", "ext_obligatorio", "ext_optativo", "laboral"
  totalHours      Int      @default(48)
  horasSemanales  Int      @default(3)
  colorHex        String   @default("#3b82f6")
  createdAt       DateTime @default(now())

  escuela         Escuela? @relation(fields: [escuelaId], references: [id], onDelete: Cascade)
  asignaciones    HorarioCargaDocente[]
  celdas          HorarioCelda[]
}

model HorarioConfiguracion {
  id                  String   @id @default(cuid())
  escuelaId           String   @unique
  diasLectivos        Int      @default(5)
  horasPorDia         Int      @default(7)
  horaInicio          String   @default("08:00")
  duracionMinutos     Int      @default(50)
  recesoTrasPeriodo   Int      @default(3)
  duracionReceso      Int      @default(20)

  escuela             Escuela  @relation(fields: [escuelaId], references: [id], onDelete: Cascade)
}

model HorarioAula {
  id           String   @id @default(cuid())
  escuelaId    String
  nombre       String   // Ej. "Laboratorio de Cómputo", "Aula 1A"
  tipo         String   @default("REGULAR")
  capacidad    Int?     @default(40)

  escuela      Escuela  @relation(fields: [escuelaId], references: [id], onDelete: Cascade)
  celdas       HorarioCelda[]
}

model HorarioGrupo {
  id           String   @id @default(cuid())
  escuelaId    String
  nombre       String   // Ej. "1° A", "2° A", "3° A"
  semestre             Int      // 1 a 6
  turno                String   @default("MATUTINO")
  capacitacionNombre   String?  // Capacitación elegida para este grupo (3° a 6° BGE)
  ffeOptativas         Json?    // Array de 4 optativas FFE para este grupo (5° y 6° BGE)
  ffeoSocioemocional   String?  // Asignatura de Formación Socioemocional elegida para este grupo
  carreraTecnicaNombre String?  // Carrera Técnica elegida (BT: CBTIS, DGETI, CBTa)
  trayectoTecnologico  String?  // Trayecto Fundamental Extendido (BT)

  escuela      Escuela  @relation(fields: [escuelaId], references: [id], onDelete: Cascade)
  asignaciones HorarioCargaDocente[]
  celdas       HorarioCelda[]

  @@unique([escuelaId, nombre])
}

model CarreraTecnica {
  id        String   @id @default(cuid())
  nombre    String   @unique // Ej. "Programación", "Mantenimiento Automotriz"
  clave     String?  // Ej. "BT-PROG"
  modulo1   String?  // Módulo I (Semestre 2, 17 hrs)
  modulo2   String?  // Módulo II (Semestre 3, 17 hrs)
  modulo3   String?  // Módulo III (Semestre 4, 17 hrs)
  modulo4   String?  // Módulo IV (Semestre 5, 12 hrs)
  modulo5   String?  // Módulo V (Semestre 6, 12 hrs)
  createdAt DateTime @default(now())
}

model HorarioCargaDocente {
  id                   String   @id @default(cuid())
  escuelaId            String
  personalId           String   // Relación con Personal (Docente)
  grupoId              String
  asignaturaId         String
  horasSemanales       Int      @default(3)
  esHoraDoblePermitida Boolean  @default(true)
  requiereAulaEspecial Boolean  @default(false)
  aulaEspecialId       String?

  escuela              Escuela                    @relation(fields: [escuelaId], references: [id], onDelete: Cascade)
  personal             Personal                   @relation(fields: [personalId], references: [id], onDelete: Cascade)
  grupo                HorarioGrupo               @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  asignatura           HorarioAsignaturaCatalogo  @relation(fields: [asignaturaId], references: [id], onDelete: Cascade)
  celdas               HorarioCelda[]
}

model HorarioGenerado {
  id             String   @id @default(cuid())
  escuelaId      String
  cicloEscolarId String
  nombreVersion  String   @default("Borrador 1")
  estado         String   @default("BORRADOR") // "BORRADOR" | "PUBLICADO"
  scoreMetricas  Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  escuela        Escuela          @relation(fields: [escuelaId], references: [id], onDelete: Cascade)
  cicloEscolar   CicloEscolar     @relation(fields: [cicloEscolarId], references: [id], onDelete: Cascade)
  celdas         HorarioCelda[]
  mensajesChat   HorarioChatMensaje[]
}

model HorarioCelda {
  id             String   @id @default(cuid())
  horarioId      String
  diaSemana      Int      // 1: Lunes ... 5: Viernes
  periodo        Int      // 1 a N
  grupoId        String
  docenteId      String
  asignaturaId   String
  aulaId         String?
  cargaId        String?
  esBloqueado    Boolean  @default(false)

  horario        HorarioGenerado       @relation(fields: [horarioId], references: [id], onDelete: Cascade)
  grupo          HorarioGrupo          @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  docente        Personal              @relation(fields: [docenteId], references: [id], onDelete: Cascade)
  asignatura     HorarioAsignaturaCatalogo @relation(fields: [asignaturaId], references: [id], onDelete: Cascade)
  aula           HorarioAula?          @relation(fields: [aulaId], references: [id], onDelete: SetNull)
  carga          HorarioCargaDocente?  @relation(fields: [cargaId], references: [id], onDelete: SetNull)
}

model HorarioChatMensaje {
  id             String   @id @default(cuid())
  horarioId      String
  role           String   // "user" | "assistant"
  content        String
  accionAplicada Json?
  createdAt      DateTime @default(now())

  horario        HorarioGenerado @relation(fields: [horarioId], references: [id], onDelete: Cascade)
}

// ─── Estadísticas de uso del Generador de Horarios por Escuela ───
// El contador NO se resetea al limpiar el historial de chat.
// Solo el administrador puede reiniciar los contadores.
model HorarioStats {
  id                  String   @id @default(cuid())
  escuelaId           String   @unique
  totalUsos           Int      @default(0)  // veces que se ha generado/confirmado un horario
  totalMensajesChat   Int      @default(0)  // mensajes enviados al chat IA acumulados (nunca se resta)
  ultimoUso           DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  escuela             Escuela  @relation(fields: [escuelaId], references: [id], onDelete: Cascade)
}

// ─── Revisión de Planeaciones y Secuencias Didácticas con IA ─────────────────

model PlaneacionDidactica {
  id                       String    @id @default(cuid())
  escuelaId                String
  cct                      String

  // Identificación docente, grupo y asignatura
  docenteNombre            String
  docenteRFC               String?
  grupoNombre              String?   // Ej. "1° A", "3° A"
  tipoSemestrePeriodo      String    @default("SEMESTRE_A") // "SEMESTRE_A" (1,3,5) | "SEMESTRE_B" (2,4,6)
  asignatura               String    // Ej. "Pensamiento Matemático I"
  semestre                 Int       // 1 a 6
  bloqueCorte              String?   // Ej. "Corte 1 - Bloque I"
  tipoAsignatura           String    @default("FUNDAMENTAL")
  // "FUNDAMENTAL" | "LABORAL" | "EXTENDIDO"

  // Archivo original subido
  archivoUrl               String
  archivoNombre            String
  archivoTipo              String    @default("PDF") // "PDF" | "DOCX"

  // Estado del proceso de revisión
  estado                   String    @default("PENDIENTE")
  // "PENDIENTE" | "EN_REVISION" | "REVISADO" | "ERROR"

  // Resultados de la evaluación
  puntajeObtenido          Float?    // 0 - 300 pts (Anexo 12 USICAMM)
  puntajeMaximo            Float?    @default(300)
  nivelCumplimiento        String?
  // "COMPLETO" | "PARCIAL" | "REQUIERE_CORRECCION"

  // Resultados estructurados en JSON
  resultadoJson            Json?
  // { rubricaUsada, criterios: [{id, criterio, puntajeMax, puntajeObtenido, cumple, evidencia, observacion, recomendacion}] }

  observacionesJson        Json?
  // { puntosFuertes: string[], mejorasUrgentes: string[], observacionesExtendidas: string }

  // Texto de retroalimentación listo para imprimir/entregar al docente
  retroalimentacionDocente String?   @db.Text

  // Metadatos de auditoría
  fechaSubida              DateTime  @default(now())
  fechaRevision            DateTime?
  revisadoPor              String?   @default("IA_GEMINI_3_5")

  escuela                  Escuela   @relation(fields: [escuelaId], references: [id], onDelete: Cascade)

  @@index([escuelaId])
  @@index([semestre])
  @@index([estado])
}

// Rúbricas y criterios de evaluación (Anexo 12 USICAMM y Lista de Cotejo)
// Se cargan en DB para que sean editables desde el panel de administración.
model RubricaPlaneacion {
  id              String   @id @default(cuid())
  rangoSemestre   String   // "1-4" | "5-6" | "LABORAL"
  nombre          String
  // "ANEXO_12_USICAMM_1_4" | "ANEXO_12_USICAMM_5_6" | "LISTA_COTEJO_1_4" | "LISTA_COTEJO_5_6" | "GUIA_LABORAL"
  descripcion     String?
  criterios       Json
  // Array de { id, criterio, descripcion, puntajeMax, categoria, instruccion }
  // Categorías: "PLANEACION_DIDACTICA" | "PRACTICA_INTERVENCION" | "EVALUACION_MEJORA"
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([rangoSemestre, nombre])
}

// Programas de Estudio Oficiales SEP cargados en la plataforma
// Se usan como contexto de alineación curricular en la evaluación de IA
model ProgramaEstudio {
  id                        String   @id @default(cuid())
  nombre                    String
  // Ej. "Pensamiento Matemático", "Ciencias Naturales", "Inglés"
  asignaturaSlug            String   @unique
  // Ej. "pensamiento-matematico", "ciencias-naturales"
  semestresAplica           Int[]    // [1, 2, 3, 4] o [5, 6]
  generacion                String
  // "2025-2028" (Propósitos Formativos) | "2023-2026" (Progresiones)
  tipoEstructura            String
  // "PROPOSITOS_FORMATIVOS" | "PROGRESIONES" | "COMPETENCIAS_LABORALES"
  propositosOProgresiones   Json
  // Array de { id, texto, contenidos: string[] }
  contenidosClave           Json     @default("[]")
  // Array de string: contenidos obligatorios mínimos
  archivoUrl                String?  // URL del PDF oficial subido en Cloudinary
  archivoNombre             String?
  activo                    Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

// Configuración global del módulo de Planeaciones (activar/desactivar)
model PlaneacionesConfig {
  id               String  @id @default("singleton")
  activoGlobal     Boolean @default(false)
  // Si false, ningún director puede usar el módulo
  requierePaecPec  Boolean @default(true)
  // Si true, exige que la escuela tenga PAEC-PEC subido antes de revisar planeaciones
  requiereApiKey   Boolean @default(true)
  // Si true, exige que la escuela tenga API Key activa
  modoSinRestricciones Boolean @default(false)
  // Si true, saltea todos los requisitos (PAEC-PEC, API Key, módulo activo, etc.) — sólo para pruebas del admin
}

// ─── Asistente Virtual y Chatbot de Trámites / Normativas SEP (RAG) ───────────

model DocumentoNormativo {
  id              String   @id @default(cuid())
  escuelaId       String?  // null = global de la supervisión
  categoria       String   // "USICAMM" | "PAEC_PEC" | "CAPEMS" | "CIRCULARES" | "TRAMITES_SEP" | "HORARIOS_CURRICULO"
  titulo          String
  descripcion     String?
  contenidoTexto  String   @db.Text // Texto completo / extracto para el motor RAG
  archivoNombre   String?
  archivoUrl      String?
  tags            String[] // ["matemáticas", "ficha-capems", "fecha-limite"]
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([categoria])
  @@index([activo])
}

model ChatTramitesMensaje {
  id          String   @id @default(cuid())
  usuarioId   String?
  role        String   // "user" | "assistant"
  content     String   @db.Text
  fuentes     Json?    // Documentos citados [{ titulo, categoria }]
  createdAt   DateTime @default(now())
}

/// Registro de auditoría de consultas y herramientas ejecutadas por el Chatbot Agéntico
model ChatAuditoriaLog {
  id               String    @id @default(cuid())
  tenantId         String
  usuarioId        String
  usuarioEmail     String?
  rolUsuario       String    // "admin" | "supervision" | "director"
  escuelaId        String?
  mensajeUsuario   String    @db.Text
  herramientaUsada String
  parametrosJson   Json?
  filasRetornadas  Int       @default(0)
  duracionMs       Int
  exitoso          Boolean   @default(true)
  errorMensaje     String?   @db.Text
  createdAt        DateTime  @default(now())

  @@index([tenantId])
  @@index([usuarioId])
  @@index([herramientaUsada])
  @@index([createdAt])
}

/// Registro de alertas generadas por el Agente de Vigilancia Proactiva
model AlertaProactiva {
  id              String    @id @default(cuid())
  tenantId        String
  reglaCodigo     String    // "REGLA_1_VENCIMIENTO_INMINENTE", "REGLA_2_OFICIO_URGENTE_SIN_ACUSE", etc.
  criticidad      String    // "CRITICA" | "ADVERTENCIA" | "INFORMATIVA"
  escuelaId       String?
  titulo          String
  descripcion     String    @db.Text
  metadata        Json?     // { diasRestantes, porcentaje, oficioId, entregaId, registro911Id }
  leida           Boolean   @default(false)
  fechaLeida      DateTime?
  archivada       Boolean   @default(false)
  fechaExpira     DateTime?
  notificadaEmail Boolean   @default(false)
  notificadan8n   Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  escuela         Escuela?  @relation(fields: [escuelaId], references: [id], onDelete: Cascade)

  @@index([tenantId, criticidad, leida])
  @@index([escuelaId, leida])
  @@index([tenantId, reglaCodigo, escuelaId, createdAt])
}

// ─── AUDITORÍA Y DESCUBRIMIENTO DE PROCESOS ATP (MULTI-TENANT) ──────────────

model CuentaAuditoria {
  id                    String    @id @default(cuid())
  tenantId              String    @default("zona004")
  email                 String    @unique
  nombreTitular         String?
  tipoFuente            String    @default("CORPUS_LOCAL") // "CORPUS_LOCAL" | "MICROSOFT_GRAPH"
  directorioCorpus      String?
  totalMensajes         Int       @default(0)
  totalRecibidos        Int       @default(0)
  totalEnviados         Int       @default(0)
  totalHilos            Int       @default(0)
  totalAdjuntos         Int       @default(0)
  fechaInicioCorpus     DateTime?
  fechaFinCorpus        DateTime?
  estadoIngestion       String    @default("PENDIENTE") // PENDIENTE | INGESTADO | PROCESANDO | ERROR
  ultimaIngestion       DateTime?
  encryptedToken        String?   @db.Text
  ivToken               String?
  authTag               String?
  tokenExpiresAt        DateTime?
  deltaToken            String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  mensajes              EmailMessage[]
  conversaciones        EmailConversation[]
  adjuntos              EmailAttachment[]
  syncStates            SyncState[]

  @@index([tenantId])
}

model EmailConversation {
  id                    String    @id @default(cuid())
  tenantId              String    @default("zona004")
  cuentaId              String
  hiloId                String    @unique // Ej. "HILO_PROBABLE_00001"
  asuntoNormalizado     String
  numMensajes           Int       @default(1)
  confianzaHilo         Int       @default(100)
  razonUnion            String?   @db.Text
  fechaInicio           DateTime
  fechaFin              DateTime
  participantesJson     Json
  mensajesIdsJson       Json?
  patronDetectado       String?
  procesoId             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  cuenta                CuentaAuditoria @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  mensajes              EmailMessage[]
  proceso               Process?        @relation(fields: [procesoId], references: [id], onDelete: SetNull)
  evidencias            Evidence[]

  @@index([tenantId])
  @@index([cuentaId])
  @@index([fechaInicio])
}

model EmailMessage {
  id                    String    @id // ID: "B_000064f1275d054a" o "E_bed5a4727a2a4114"
  tenantId              String    @default("zona004")
  cuentaId              String
  hiloId                String?
  bandeja               String    // "BandejaEntrada" | "Enviados"
  esEnviado             Boolean   @default(false)
  fechaMensaje          DateTime
  remitenteNombre       String?
  remitenteEmail        String?
  destinatariosJson     Json      // [{ name, email }]
  conCopiaJson          Json?     // [{ name, email }]
  asunto                String
  asuntoNormalizado     String?
  categoriaTematica     String?
  rutaMd                String?   // "Correos/BandejaEntrada/B_000064f1275d054a.md"
  
  // Señales de Auditoría
  bodyHash              String?
  tamanoCuerpoChars     Int       @default(0)
  tieneAdjuntos         Boolean   @default(false)
  numAdjuntos           Int       @default(0)
  tieneSenalesPlazo     Boolean   @default(false)
  esDuplicado           Boolean   @default(false)
  duplicadoDeId         String?
  
  // Análisis Semántico IA
  estadoAnalisis        String    @default("METADATOS_CARGADOS")
  resumenIA             String?   @db.Text
  clasificacionOrigen   String?
  clasificacionTipo     String?
  clasificacionAccion   String?
  fechaLimiteDetectada  DateTime?
  prioridadIA           String?   @default("MEDIA")
  confianzaIA           Float?    @default(1.0)
  entidadesJson         Json?

  procesoId             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  cuenta                CuentaAuditoria    @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  conversation          EmailConversation? @relation(fields: [hiloId], references: [hiloId], onDelete: SetNull)
  proceso               Process?           @relation(fields: [procesoId], references: [id], onDelete: SetNull)
  adjuntos              EmailAttachment[]
  evidencias            Evidence[]

  @@index([tenantId])
  @@index([cuentaId])
  @@index([bandeja])
  @@index([fechaMensaje])
  @@index([clasificacionOrigen])
  @@index([clasificacionTipo])
}

model EmailAttachment {
  id                    String    @id @default(cuid())
  tenantId              String    @default("zona004")
  cuentaId              String
  mensajeId             String
  nombre                String
  categoria             String?   // "PDF", "Word", "Excel", "Imagenes", "Otros"
  extension             String?   // ".pdf", ".docx", ".xlsx", ".png"
  tamanoBytes           Int       @default(0)
  rutaOriginal          String?   // "Adjuntos/PDF/documento.pdf"
  rutaMd                String?   // "Adjuntos_md/PDF/documento.pdf.md"
  procesoId             String?
  createdAt             DateTime  @default(now())

  cuenta                CuentaAuditoria @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  mensaje               EmailMessage    @relation(fields: [mensajeId], references: [id], onDelete: Cascade)
  proceso               Process?        @relation(fields: [procesoId], references: [id], onDelete: SetNull)
  evidencias            Evidence[]

  @@index([tenantId])
  @@index([cuentaId])
  @@index([mensajeId])
  @@index([categoria])
}

model Process {
  id                    String    @id // Ej: "ATP-PROC-001"
  tenantId              String    @default("zona004")
  nombre                String
  descripcion           String    @db.Text
  origenPrincipal       String
  frecuenciaEstimada    String
  participantes         Json
  entradas              Json
  salidas               Json
  documentosRelacionados Json
  nivelRepeticion       String
  
  // Tiempos y Estimaciones (Rangos)
  tiempoEstimadoMinHoras Float
  tiempoEstimadoMaxHoras Float
  ahorroEstimadoHoras    Float
  
  // Clasificación y Prioridad
  automatizabilidad     Int
  prioridadScore        Float
  nivelPrioridad        String
  riesgoOperativo       String
  confianzaScore        Float
  razonDeteccion        String    @db.Text
  
  // Gobernanza
  estado                String    @default("PROPUESTO")
  notasAdmin            String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tareas                Task[]
  mensajes              EmailMessage[]
  conversaciones        EmailConversation[]
  adjuntos              EmailAttachment[]
  evidencias            Evidence[]
  planesModulo          ModulePlan[]
  gapItems              GapItem[]
  correcciones          ProcesoCorreccion[]

  @@index([tenantId])
}

model Task {
  id                    String    @id // Ej: "TAR-001"
  tenantId              String    @default("zona004")
  procesoId             String
  nombre                String
  descripcion           String?   @db.Text
  responsableActual     String?
  responsablePropuesto  String?
  automatizabilidad     Int?      @default(1)
  automatizabilidadDesc String?   @db.Text
  automatizacionPropuesta String? @db.Text
  frecuencia            String?
  frecuenciaAnual       Int?      @default(0)
  tiempoMinUnitario     Int?      @default(0)
  tiempoMaxUnitario     Int?      @default(0)
  horasMinAno           Float?    @default(0)
  horasMaxAno           Float?    @default(0)
  duracionMinutosMin    Int       @default(15)
  duracionMinutosMax    Int       @default(60)
  herramientasUsadas    Json?
  actividadManualTipo   String?
  estado                String    @default("IDENTIFICADO")
  createdAt             DateTime  @default(now())

  proceso               Process   @relation(fields: [procesoId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([procesoId])
}

model Discovery {
  id              String    @id @default(cuid())
  tenantId        String    @default("zona004")
  tipo            String
  titulo          String
  descripcion     String    @db.Text
  confianzaScore  Float
  razonEvidencia  String    @db.Text
  evidenciaIdsJson Json
  estado          String    @default("ACTIVO")
  createdAt       DateTime  @default(now())

  @@index([tenantId])
}

model Evidence {
  id              String    @id @default(cuid())
  tenantId        String    @default("zona004")
  procesoId       String?
  mensajeId       String?
  conversacionId  String?
  adjuntoId       String?
  tipoFuente      String
  citaTexto       String    @db.Text
  metadatosJson   Json?
  createdAt       DateTime  @default(now())

  proceso         Process?           @relation(fields: [procesoId], references: [id], onDelete: Cascade)
  mensaje         EmailMessage?      @relation(fields: [mensajeId], references: [id], onDelete: SetNull)
  conversacion    EmailConversation? @relation(fields: [conversacionId], references: [id], onDelete: SetNull)
  adjunto         EmailAttachment?   @relation(fields: [adjuntoId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([procesoId])
}

model ProcesoCorreccion {
  id              String    @id @default(cuid())
  tenantId        String    @default("zona004")
  procesoId       String?
  tipoCorreccion  String
  reglaTexto      String    @db.Text
  valorAnterior   Json?
  valorNuevo      Json?
  aplicadoPor     String
  createdAt       DateTime  @default(now())

  proceso         Process?  @relation(fields: [procesoId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model ModulePlan {
  id                    String    @id // Ej: "ATP-MOD-01"
  tenantId              String    @default("zona004")
  procesoOrigenId       String?
  nombreModulo          String
  faseRoadmap           Int
  objetivo              String    @db.Text
  problemaQueResuelve   String    @db.Text
  especificacionJson    Json
  especificacionMd      String?   @db.Text
  prioridad             String
  complejidad           String
  beneficioCualitativo  String    @db.Text
  ahorroHorasAnualMin   Float
  ahorroHorasAnualMax   Float
  estado                String    @default("PENDIENTE") // PENDIENTE | APROBADO | RECHAZADO | MODIFICADO | EN_ESPERA
  fechaDecision         DateTime?
  decisionPor           String?
  comentarioDecision    String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  procesoOrigen         Process?  @relation(fields: [procesoOrigenId], references: [id], onDelete: SetNull)

  @@index([tenantId])
}

model GapItem {
  id                    String    @id @default(cuid())
  tenantId              String    @default("zona004")
  procesoId             String?
  nombreProceso         String
  plataformaActual      String
  estadoCobertura       String
  funcionalidadFaltante String    @db.Text
  solucionPropuesta     String    @db.Text
  prioridad             String
  createdAt             DateTime  @default(now())

  proceso               Process?  @relation(fields: [procesoId], references: [id], onDelete: SetNull)

  @@index([tenantId])
}

model SyncState {
