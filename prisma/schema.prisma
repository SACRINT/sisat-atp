  escuelaId      String
  escuela        Escuela  @relation(fields: [escuelaId], references: [id])
  cicloEscolar   String   // Ej. "2024-2025", "2023-2024"
  semestre       Int?     // 1 al 6
  grupo          String?  // Ej. "A", "B"
  datosExtraidos Json     // { alumnos: [...], materias: [...], promedios: [...] }
  confidence     Float    @default(0.9)
  archivoUrl     String?  // URL del escaneo PDF/Imagen
  procesadoPor   String?  // Email del usuario que subió/ejecutó el OCR
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([escuelaId])
  @@index([cicloEscolar])
}


