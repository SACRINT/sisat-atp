  comiteId      String
  tipoDocumento String    @default("ACTA") // ACTA | FOTOGRAFIA | INFORME | OTRO
  nombreArchivo String?
  sha256Hash    String?
  fechaDocumento DateTime?
  observaciones String?   @db.Text
  createdAt     DateTime  @default(now())

  comite        ComiteEscolarRegistro @relation(fields: [comiteId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([comiteId])
}


