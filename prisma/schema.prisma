// ─── ATP-MOD-01: Gestión Central de Oficios, Circulares y Plazos Urgentes ─────

/// Estado de ciclo de vida de un oficio o circular
enum EstadoOficio {
  RECIBIDO
  ENVIADO
  ACUSADO
  VENCIDO
  CANCELADO
}

/// Criticidad calculada por horas restantes al plazo (configurable en OficioConfig)
enum CriticidadOficio {
  VERDE    // > umbralAmarillo horas
  AMARILLO // <= umbralAmarillo y > umbralRojo horas
  ROJO     // <= umbralRojo horas o vencido
}

/// Oficio o circular institucional
model Oficio {
  id                  String            @id @default(cuid())
  tenantId            String
  /// Número oficial del oficio (ej. DGDC/ATP/2025/001)
  numeroOficio        String
  asunto              String
  remitenteNombre     String?
  remitenteEmail      String?
  /// Fecha y hora límite para acuse o respuesta
  fechaLimite         DateTime?
  /// Fecha de recepción del oficio
  fechaRecepcion      DateTime          @default(now())
  estado              EstadoOficio      @default(RECIBIDO)
  criticidad          CriticidadOficio  @default(VERDE)
  /// Ruta relativa al archivo original (PDF/imagen) — nunca almacenamos el payload
  rutaArchivo         String?
  /// Hash SHA-256 del archivo para integridad
  sha256Hash          String?
  /// Extracción IA: metadatos normalizados (remitente, asunto, fechaLimite, instrucciones)
  metadatosIA         Json?
  /// Indicador de si la IA ya procesó el archivo
  iaProcessed         Boolean           @default(false)
  /// Notas manuales del ATP
  notas               String?           @db.Text
  /// Si es true, es un oficio recibido externo; false = generado internamente
  esRecibido          Boolean           @default(true)

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  destinatarios       OficioDestinatario[]
  recordatorios       OficioRecordatorioLog[]

  @@index([tenantId])
  @@index([tenantId, estado])
  @@index([tenantId, criticidad])
  @@index([tenantId, fechaLimite])
}

/// Distribución del oficio a escuelas y seguimiento de acuse por plantel
model OficioDestinatario {
  id                  String    @id @default(cuid())
  tenantId            String
  oficioId            String
  escuelaId           String?
  escuelaNombre       String?
  escuelaCCT          String?
  emailDestino        String?
  /// Fecha en que se envió el correo de distribución
  fechaEnvioCorreo    DateTime?
  /// Si el acuse fue recibido (firmado o confirmado digitalmente)
  acuseRecibido       Boolean   @default(false)
  fechaAcuse          DateTime?
  /// Ruta al archivo de acuse firmado subido por el director
  rutaAcuse           String?
  sha256Acuse         String?
  /// Confirmación manual por el ATP (botón "Confirmar recepción")
  confirmadoATP       Boolean   @default(false)
  fechaConfirmacionATP DateTime?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  oficio              Oficio    @relation(fields: [oficioId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([oficioId])
  @@index([tenantId, acuseRecibido])
}

/// Log de recordatorios enviados (48h y 12h antes del vencimiento)
model OficioRecordatorioLog {
  id          String    @id @default(cuid())
  tenantId    String
  oficioId    String
  tipo        String    // "48H" | "12H" | "VENCIDO"
  enviadoEn   DateTime  @default(now())
  exitoso     Boolean   @default(true)
  errorMsg    String?

  oficio      Oficio    @relation(fields: [oficioId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([oficioId])
}

/// Configuración del módulo de oficios por tenant (singleton por tenant)
model OficioConfig {
  id                  String    @id @default(cuid())
  tenantId            String    @unique
  /// Umbral en horas para semáforo ROJO (default 24)
  umbralRojoHoras     Int       @default(24)
  /// Umbral en horas para semáforo AMARILLO (default 72)
  umbralAmarilloHoras Int       @default(72)
  /// Email del remitente institucional para distribución (sin hardcode en código)
  cuentaRemitente     String?
  /// Plantilla DOCX base para generar acuses (ruta relativa en FORMATOS_DIR)
  plantillaAcuseDocx  String?
  /// Hora de día (24h) en que el cron revisa vencimientos (ej. "07:00")
  horaIngesta         String    @default("07:00")
  /// Notificaciones activas
  recordatorios48h    Boolean   @default(true)
  recordatorios12h    Boolean   @default(true)
  activo              Boolean   @default(true)
  visibleEnDirector   Boolean   @default(true)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([tenantId])
}

/// Registro centralizado de errores de servidor (P4)
model ErrorLog {
  id        String   @id @default(cuid())
  tenantId  String?
  ruta      String
  metodo    String
  mensaje   String   @db.Text
  stack     String?  @db.Text
  userId    String?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([createdAt])
}

// ─── ATP-MOD-02: Plantillas de Personal SPARH / CENSUS ───

enum EstadoPlantilla {
  PENDIENTE
  RECIBIDO
  VALIDADO
  CON_ERRORES
  CORREGIR
  LISTO_PARA_CORDE
  ENTREGADO_A_CORDE
  CARGADO
  EN_VALIDACION
  CONSOLIDADO
}

enum SeveridadInconsistencia {
  INFO
  ADVERTENCIA
  ERROR_CRITICO
}

/// Registro de entregables y sábanas de plantillas de personal por escuela
model PlantillaPersonalRegistro {
  id                      String            @id @default(cuid())
  tenantId                String
  escuelaId               String?
  escuelaNombre           String?
  escuelaCCT              String?
  nombreArchivo           String
  sha256Hash              String
  rutaArchivo             String?
  pdfNombre               String?
  pdfUrl                  String?
  excelNombre             String?
  excelUrl                String?
  fechaEntregaPdf         DateTime?
  fechaSubidaExcel        DateTime?
  observacionesSupervision String?           @db.Text
  totalRegistros          Int               @default(0)
  totalHoras              Float             @default(0)
  estado                  EstadoPlantilla   @default(PENDIENTE)
  metadatos               Json?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  plazas                  PlantillaDetallePlaza[]
  inconsistencias         PlantillaInconsistencia[]

  @@index([tenantId])
  @@index([tenantId, escuelaId])
  @@index([tenantId, estado])
}

/// Detalle de plazas capturadas en la sábana de personal
model PlantillaDetallePlaza {
  id                  String                    @id @default(cuid())
  tenantId            String
  plantillaRegistroId String
  escuelaCCT          String?
  rfc                 String?
  curp                String?
  nombreDocente       String?
  clavePlaza          String?
  funcion             String?
  horasAsignadas      Float                     @default(0)
  tipoJornada         String?
  esIncompatible      Boolean                   @default(false)
  datosExtra          Json?
  createdAt           DateTime                  @default(now())

  plantillaRegistro   PlantillaPersonalRegistro @relation(fields: [plantillaRegistroId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([plantillaRegistroId])
  @@index([tenantId, rfc])
  @@index([tenantId, curp])
}

/// Inconsistencias y errores aritméticos/estructurales detectados en las plantillas
model PlantillaInconsistencia {
  id                  String                  @id @default(cuid())
  tenantId            String
  plantillaRegistroId String
  escuelaCCT          String?
  tipoInconsistencia  String                  // DUPLICADO_RFC, EXCESO_HORAS, CAMPO_VACIO, INCOMPATIBILIDAD_PLAZA
  severidad           SeveridadInconsistencia @default(ADVERTENCIA)
  filaNumero          Int?
  columnaCampo        String?
  valorEncontrado     String?
  descripcion         String                  @db.Text
  detalles            Json?
  createdAt           DateTime                @default(now())

  plantillaRegistro   PlantillaPersonalRegistro @relation(fields: [plantillaRegistroId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([plantillaRegistroId])
  @@index([tenantId, tipoInconsistencia])
}

/// Configuración de validación y corte oficial para plantillas SPARH por tenant
model PlantillaCorteConfig {
  id                      String    @id @default(cuid())
  tenantId                String    @unique
  maxHorasJornadaDocente  Float     @default(40)
  permitirDoblePlaza      Boolean   @default(false)
  fechaCorteOficial       DateTime?
  notificarInconsistencias Boolean   @default(true)
  activo                  Boolean   @default(true)
  visibleEnDirector       Boolean   @default(true)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([tenantId])
}

// ══════════════════════════════════════════════════════════════════════════════
// ─── ATP-MOD-03: Auditoría y Validación Estadística 911 / SICEP ───────────────
// ══════════════════════════════════════════════════════════════════════════════

enum EstadoEstadistica911 {
  PENDIENTE
  CON_INCONSISTENCIAS
  VALIDADO
  ENTREGADO_A_CORDE
}

/// Configuración de corte y periodos para Estadística 911 por tenant
model EstadisticaPeriodoConfig {
  id                String    @id @default(cuid())
  tenantId          String    @unique
  cicloEscolarId    String?
  tipoCorte         String    @default("INICIO_DE_CURSOS") // "INICIO_DE_CURSOS" | "FIN_DE_CURSOS"
  fechaLimite       DateTime?
  activo            Boolean   @default(true)
  visibleEnDirector Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([tenantId])
}

/// Registro de entrega y validación de formato 911.8 por escuela
model Estadistica911Registro {
  id                  String                    @id @default(cuid())
  tenantId            String
  cicloEscolarId      String
  escuelaId           String
  escuelaCCT          String
  tipoCorte           String                    @default("INICIO_DE_CURSOS") // "INICIO_DE_CURSOS" | "FIN_DE_CURSOS"
  archivoUrl          String?
  archivoNombre       String?
  sha256Hash          String?
  tamanoBytes         Int?
  
  // Totales consolidados de la escuela
  totalHombres        Int                       @default(0)
  totalMujeres        Int                       @default(0)
  totalAlumnos        Int                       @default(0)
  totalGrupos         Int                       @default(0)
  totalDocentes       Int                       @default(0)
  totalAprobados      Int                       @default(0)
  totalReprobados     Int                       @default(0)
  totalEgresados      Int                       @default(0)
  totalDesercion      Int                       @default(0)

  // Estado del flujo de validación y control
  estado              EstadoEstadistica911      @default(PENDIENTE) // PENDIENTE, CON_INCONSISTENCIAS, VALIDADO, ENTREGADO_A_CORDE
  inconsistenciasJson Json?                     // Arreglo de discrepancias aritméticas detectadas
  notasAtp            String?                   @db.Text

  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  escuela             Escuela                   @relation(fields: [escuelaId], references: [id], onDelete: Cascade)
  cicloEscolar        CicloEscolar              @relation(fields: [cicloEscolarId], references: [id], onDelete: Cascade)
  detalles            EstadisticaDetalleGrado[]
  crucesSicep         EstadisticaCruceSicep[]

  @@unique([tenantId, cicloEscolarId, escuelaId, tipoCorte])
  @@index([tenantId])
  @@index([cicloEscolarId])
  @@index([escuelaId])
  @@index([tenantId, estado])
}

/// Desglose de matrícula por semestre (1º a 6º) y distribución por edades
model EstadisticaDetalleGrado {
  id                  String                 @id @default(cuid())
  tenantId            String
  registroId          String
  semestreGrado       Int                    // 1 a 6
  hombres             Int                    @default(0)
  mujeres             Int                    @default(0)
  total               Int                    @default(0)
  grupos              Int                    @default(0)
  desgloseEdades      Json?                  // {"14": {"h": 5, "m": 6}, "15": ...}
  createdAt           DateTime               @default(now())

  registro            Estadistica911Registro @relation(fields: [registroId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([registroId])
  @@index([registroId, semestreGrado])
}

/// Cruce de consistencia entre formato 911 y matrícula reportada en SICEP
model EstadisticaCruceSicep {
  id                  String                 @id @default(cuid())
  tenantId            String
  registroId          String
  matriculaSicepTotal Int                    @default(0)
  matricula911Total   Int                    @default(0)
  diferencia          Int                    @default(0)
  discrepancias       Json?                  // Lista de alumnos o grupos con discordancia
  createdAt           DateTime               @default(now())

  registro            Estadistica911Registro @relation(fields: [registroId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([registroId])
}



// ─────────────────────────────────────────────────────────────────────────────
// ATP-MOD-06: Acompañamiento a Consejos Técnicos Escolares (CTE)
// ─────────────────────────────────────────────────────────────────────────────

enum TipoFaseCte {
  INTENSIVA
  ORDINARIA
}

/// Configuración global de una sesión de CTE (administrada por el ATP)
model CteSesionConfig {
  id          String      @id @default(cuid())
  tenantId    String      @default("zona004")
  numero      Int         // Número de sesión (1, 2, 3...)
  fase        TipoFaseCte @default(ORDINARIA)
  tipoSesion  String      @default("CAPEMS") // "CAPEMS" | "REUNION_ESTRUCTURA"
  descripcion String?
  fechaSesion DateTime?
  fechaLimite DateTime?   // Fecha límite de entrega del producto
  guiaUrl             String?     // Enlace a la guía de trabajo oficial
  archivoNombre       String?     // nombre original subido
  archivoUrl          String?     // secure_url de Cloudinary
  archivoPublicId     String?     // public_id de Cloudinary (para descarga firmada/borrado)
  sha256Hash          String?     // integridad (mismo patrón que oficios)
  iaProcessed         Boolean     @default(false)
  temasIA             Json?       // array [{ titulo: string, descripcion: string | null, nivelAplicable?: string }]
  acuerdosSugeridosIA Json?       // array [{ texto: string }]
  contenidoTexto      String?     @db.Text // Texto completo de diapositivas indexado para búsqueda RAG
  activo              Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  productos   CteProductoEscuela[]
  compromisos CteCompromisoZonal[]

  @@unique([tenantId, numero, fase, tipoSesion])
  @@index([tenantId])
}

/// Producto/acta entregado por una escuela en una sesión de CTE
model CteProductoEscuela {
  id          String    @id @default(cuid())
  tenantId    String    @default("zona004")
  sesionId    String
  escuelaId   String
  cicloId     String?
  nombreArchivo String?
  sha256Hash  String?                         // Integridad — sin guardar contenido
  estado      String    @default("PENDIENTE") // PENDIENTE | ENTREGADO | REVISADO | OBSERVACIONES
  notasAtp    String?   @db.Text
  compromisos Json?                           // JSON estructurado con compromisos extraídos por IA
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sesion      CteSesionConfig @relation(fields: [sesionId], references: [id], onDelete: Cascade)
  escuela     Escuela         @relation(fields: [escuelaId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sesionId, escuelaId])
  @@index([tenantId])
  @@index([sesionId])
  @@index([escuelaId])
}

/// Compromiso zonal consolidado extraído o administrado en CTE
model CteCompromisoZonal {
  id               String          @id @default(cuid())
  tenantId         String          @default("zona004")
  sesionId         String
  texto            String          @db.Text
  categoria        String?         // Eje temático: "APRENDIZAJES", "CONVIVENCIA", "GESTION", "FORMACION_DOCENTE"
  prioridad        Int             @default(1) // 1: Normal, 2: Media, 3: Alta
  estado           String          @default("PENDIENTE") // PENDIENTE | EN_PROCESO | RESUELTO
  resuelto         Boolean         @default(false)
  fechaLimite      DateTime?       // Fecha límite específica opcional
  escuelasIds      Json?           // Array de ids de escuelas involucradas o null si es zonal general
  notasSeguimiento String?         @db.Text
  origenIA         Boolean         @default(false)
  oficializado     Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  sesion           CteSesionConfig @relation(fields: [sesionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([sesionId])
  @@index([tenantId, estado])
  @@index([tenantId, resuelto])
}


